#Это корневой файл для всего проекта
root = true

#Правила для всех файлов(*)
[*]
#Использовать кодировку UTF-8
Charset = utf-8
#Использовать пробелы для отступов
indent_style = space
#Размер отступа: 4 пробела
indent_size = 4
#Тип переноса строки: LF
end_of_line = If
#Удалить проблы в конце строк
trin_trailling_whinesplace = true
#Добавить пустую сроку в конце файла
insert_final_newline = true
  
#Особые правила для файлов разметки
[*.{yml,yaml,json,html}]
indent_size = 2
